---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'writing' | 'projects' | 'about';
}

const {
  title = 'Ram Alapure',
  description = 'AI systems for regulated industries. Java, agents, production engineering.',
  current,
} = Astro.props;

const pageTitle = title === 'Ram Alapure' ? title : `${title} · Ram Alapure`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var pref = 'system';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') pref = stored;
        } catch (e) {}
        var resolved =
          pref === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : pref;
        var root = document.documentElement;
        root.dataset.theme = resolved;
        root.dataset.themePref = pref;
        root.style.colorScheme = resolved;
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-name" href="/">Ram Alapure</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/writing/" class:list={{ active: current === 'writing' }}>Writing</a>
          <a href="/projects/" class:list={{ active: current === 'projects' }}>Projects</a>
          <a href="/about/" class:list={{ active: current === 'about' }}>About</a>
        </nav>
        <button type="button" class="theme-toggle" aria-label="Switch theme">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              d="M12 3v1.5M12 19.5V21M4.93 4.93l1.06 1.06M18.01 18.01l1.06 1.06M3 12h1.5M19.5 12H21M4.93 19.07l1.06-1.06M18.01 5.99l1.06-1.06"
            ></path>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20 14.5A8.5 8.5 0 1 1 9.5 4 7 7 0 0 0 20 14.5z"
            ></path>
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="mailto:alapureram@gmail.com">alapureram@gmail.com</a>
      <a href="https://www.linkedin.com/in/ramalapure" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/RamAlapure" target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>
    <script>
      import { initThemeControls } from '../scripts/theme';
      initThemeControls();
    </script>
  </body>
</html>
