---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatSeriesLabel, WRITING_SERIES_NAME } from '../../lib/writing';

const posts = (await getCollection('writing')).sort((a, b) => a.data.series - b.data.series);
---

<BaseLayout
  title="Writing"
  description="Production AI Patterns — a 17-part series on deterministic control, agents, and enterprise engineering."
  current="writing"
>
  <div class="page">
    <h1>Writing</h1>
    <p class="lead">
      {WRITING_SERIES_NAME} — production-grade AI agent architecture with deterministic control, not demos.
    </p>

    <ul class="entry-list">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.slug}/`}>{post.data.title}</a>
          <div class="entry-meta">
            {formatSeriesLabel(post.data.series)}
            {post.data.date ? ` · ${post.data.date}` : ''}
            {post.data.tags.length > 0 && ` · ${post.data.tags.join(' · ')}`}
          </div>
          <p class="entry-summary">{post.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
