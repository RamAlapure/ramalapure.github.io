---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const shipped = (await getCollection('projects'))
  .filter((p) => p.data.status === 'shipped')
  .sort((a, b) => a.data.order - b.data.order);

const lab = (await getCollection('projects'))
  .filter((p) => p.data.status === 'lab')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Shipped engineering work and lab experiments — production systems and intentional explorations."
  current="projects"
>
  <div class="page">
    <h1>Projects</h1>
    <p class="lead">Shipped engineering work and lab explorations.</p>

    <section class="list-section">
      <h2>Shipped</h2>
      <ul class="entry-list">
        {shipped.map((project) => (
          <li>
            <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
            {project.data.award && <div class="project-award">{project.data.award}</div>}
            <div class="entry-meta">{project.data.description}</div>
          </li>
        ))}
      </ul>
    </section>

    <section class="list-section">
      <h2>Lab</h2>
      <p class="section-lead">Experiments before they become production systems.</p>
      <ul class="entry-list">
        {lab.map((project) => (
          <li>
            <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
            <div class="entry-meta status-lab">{project.data.description}</div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
