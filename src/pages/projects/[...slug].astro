---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidInit from '../../components/MermaidInit.astro';
import { getCollection } from 'astro:content';
import { formatSeriesLabel } from '../../lib/writing';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const writingBySlug = new Map(
  (await getCollection('writing')).map((post) => [post.slug, post]),
);
const relatedPosts = project.data.related
  .map((slug) => writingBySlug.get(slug))
  .filter((post): post is NonNullable<typeof post> => post !== undefined);
---

<BaseLayout title={project.data.title} description={project.data.description} current="projects">
  <article class="page prose">
    <p class="muted">
      <span class={project.data.status === 'lab' ? 'status-lab' : 'status-shipped'}>
        {project.data.status}
      </span>
    </p>
    <h1>{project.data.title}</h1>
    {project.data.award && <p class="project-award">{project.data.award}</p>}
    {project.slug === 'early-learning' && (
      <p class="playground-cta">
        <a href="/learn/" target="_blank" rel="noopener noreferrer">
          Open Learning Playground ↗
        </a>
      </p>
    )}
    <Content />

    {relatedPosts.length > 0 && (
      <section class="related-writing">
        <h2>Related thinking</h2>
        <ul class="entry-list">
          {relatedPosts.map((post) => (
            <li>
              <a href={`/writing/${post.slug}/`}>{post.data.title}</a>
              <div class="entry-meta">{formatSeriesLabel(post.data.series)}</div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p><a href="/projects/">← All projects</a></p>
  </article>
  <MermaidInit />
</BaseLayout>
