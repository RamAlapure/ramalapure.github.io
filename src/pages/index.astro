---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatSeriesLabel } from '../lib/writing';

const posts = (await getCollection('writing')).sort((a, b) => a.data.series - b.data.series);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const latestPosts = [...posts]
  .sort((a, b) => {
    const da = a.data.date ?? '';
    const db = b.data.date ?? '';
    return db.localeCompare(da) || b.data.series - a.data.series;
  })
  .slice(0, 4);

const shipped = projects.filter((p) => p.data.status === 'shipped');
const featuredSlugs = ['eliza4j', 'finos-dtcc-hackathon', 'datalake-wealth'];
const featuredProjects = featuredSlugs
  .map((slug) => shipped.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const siteDescription =
  'Ram Alapure builds production-grade AI for regulated industries—Java, Spring, agent systems, and deterministic control.';
---

<BaseLayout description={siteDescription}>
  <div class="page">
    <section class="hero">
      <h1>I design production-grade AI for regulated industries.</h1>
      <p class="lead">Java, Spring, and agent systems with deterministic control — not demos.</p>
      <p class="muted stack-line">Java · Spring · Agent Systems · AI Governance</p>
      <p class="hero-actions">
        <a href="/projects/">Explore my work</a>
        <span class="hero-actions-sep">·</span>
        <a href="/writing/">Read my thinking</a>
      </p>
    </section>

    <section class="list-section">
      <h2>What I build</h2>
      <ul class="concept-list">
        <li>
          <strong>Enterprise AI</strong> — systems that operate inside real enterprise constraints.
        </li>
        <li>
          <strong>Agent systems</strong> — orchestration, tools, MCP, RAG, validation.
        </li>
        <li>
          <strong>Reliable AI</strong> — security, governance, observability, deterministic control.
        </li>
      </ul>
    </section>

    <section class="list-section">
      <h2>How I think about production AI</h2>
      <ul class="principles-list">
        <li>Deterministic control.</li>
        <li>Least privilege.</li>
        <li>Validation before trust.</li>
        <li>Human control for high-impact decisions.</li>
      </ul>
    </section>

    <section class="list-section">
      <h2>Selected work</h2>
      <ul class="entry-list">
        {featuredProjects.map((project) => (
          <li>
            <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
            {project.data.award && <div class="project-award">{project.data.award}</div>}
            <div class="entry-meta">{project.data.description}</div>
          </li>
        ))}
      </ul>
      <p><a href="/projects/">More projects →</a></p>
    </section>

    <section class="list-section">
      <h2>Recent thinking</h2>
      <ul class="entry-list">
        {latestPosts.map((post) => (
          <li>
            <a href={`/writing/${post.slug}/`}>{post.data.title}</a>
            <div class="entry-meta">
              {formatSeriesLabel(post.data.series)}
              {post.data.date ? ` · ${post.data.date}` : ''}
            </div>
            {post.data.summary && <p class="entry-summary">{post.data.summary}</p>}
          </li>
        ))}
      </ul>
      <p><a href="/writing/">All writing →</a></p>
    </section>
  </div>
</BaseLayout>
